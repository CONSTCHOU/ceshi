{
  "name": "ai-web-extractor",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "test": "playwright test",
    "build:exe": "ts-node scripts/build.ts",
    "postbuild:exe": "node scripts/post-build.js",
    "package": "npm run build:exe && npm run create-installer"
  },
  "dependencies": {
    "playwright": "^1.40.0",
    "@playwright/test": "^1.40.0",
    "openai": "^4.0.0",
    "axios": "^1.6.0",
    "xlsx": "^0.18.5",
    "dotenv": "^16.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "@google/generative-ai": "^0.1.3",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "node-schedule": "^2.1.1",
    "memory-cache": "^0.2.0",
    "pkg": "^5.8.1",
    "check-disk-space": "^3.3.1",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.1.1",
    "archiver": "^5.3.1",
    "electron-winstaller": "^5.1.0",
    "semver": "^7.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/playwright": "^1.40.0",
    "@types/node-schedule": "^2.1.0",
    "@types/memory-cache": "^0.2.5",
    "@types/fs-extra": "^11.0.1",
    "@types/archiver": "^5.3.2",
    "@types/semver": "^7.5.0"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*",
      "dist/**/*",
      "config/**/*",
      "resources/**/*",
      "public/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "node16-win-x64"
    ],
    "outputPath": "dist"
  }
} 